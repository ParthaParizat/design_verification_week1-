{
  "design": "ALU",
  "version": "1.0",
  "bit_width": 8,
  "total_testcases": 8,
  "testcases": [
    {
      "id": "TC001",
      "op": "ADD",
      "opcode": "3'b000",
      "a": 10,
      "b": 5,
      "expected": 15,
      "zero_flag_expected": false,
      "type": "normal",
      "description": "Basic addition"
    },
    {
      "id": "TC002",
      "op": "ADD",
      "opcode": "3'b000",
      "a": 200,
      "b": 100,
      "expected": 44,
      "zero_flag_expected": false,
      "type": "boundary",
      "description": "Addition overflow — result wraps around (300 mod 256 = 44)"
    },
    {
      "id": "TC003",
      "op": "SUB",
      "opcode": "3'b001",
      "a": 10,
      "b": 10,
      "expected": 0,
      "zero_flag_expected": true,
      "type": "normal",
      "description": "Subtraction resulting in zero — checks zero_flag"
    },
    {
      "id": "TC004",
      "op": "SUB",
      "opcode": "3'b001",
      "a": 0,
      "b": 5,
      "expected": 251,
      "zero_flag_expected": false,
      "type": "boundary",
      "description": "Underflow — 0 - 5 wraps to 251 in unsigned 8-bit"
    },
    {
      "id": "TC005",
      "op": "AND",
      "opcode": "3'b010",
      "a": "0xAA",
      "b": "0x55",
      "expected": "0x00",
      "zero_flag_expected": true,
      "type": "normal",
      "description": "AND of alternating bit patterns — result is 0"
    },
    {
      "id": "TC006",
      "op": "DIV",
      "opcode": "3'b110",
      "a": 10,
      "b": 0,
      "expected": "0xFF",
      "zero_flag_expected": false,
      "type": "invalid",
      "description": "Divide by zero — design returns 0xFF as error code"
    },
    {
      "id": "TC007",
      "op": "DIV",
      "opcode": "3'b110",
      "a": 10,
      "b": 2,
      "expected": 5,
      "zero_flag_expected": false,
      "type": "normal",
      "description": "Normal integer division"
    },
    {
      "id": "TC008",
      "op": "XOR",
      "opcode": "3'b100",
      "a": "0xFF",
      "b": "0xFF",
      "expected": "0x00",
      "zero_flag_expected": true,
      "type": "normal",
      "description": "XOR of identical values — always produces zero"
    }
  ]
}
